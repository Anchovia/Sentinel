{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantforge.local/schemas/automation-report-1.json",
  "title": "QuantForge automation report manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "task_id", "actor", "skill", "started_at_utc",
    "completed_at_utc", "source_revision", "severity", "outcome", "summary",
    "report_path", "writes", "safety"
  ],
  "properties": {
    "schema_version": {"const": "automation-report-1"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$", "maxLength": 100},
    "task_id": {"type": "string", "pattern": "^[a-z0-9.-]+$", "maxLength": 100},
    "actor": {"enum": ["work", "codex"]},
    "skill": {
      "enum": [
        "quantforge-ops-audit", "quantforge-performance-review",
        "quantforge-data-quality", "quantforge-model-drift",
        "quantforge-incident-triage", "quantforge-code-audit",
        "quantforge-strategy-research", "quantforge-dependency-review",
        "quantforge-disaster-recovery"
      ]
    },
    "started_at_utc": {"type": "string", "format": "date-time"},
    "completed_at_utc": {"type": "string", "format": "date-time"},
    "source_revision": {"type": "string", "pattern": "^[a-f0-9]{7,64}$"},
    "severity": {"enum": ["NORMAL", "WARNING", "HIGH", "CRITICAL"]},
    "outcome": {"enum": ["NO_ACTION", "REPORT_ONLY", "CHANGE_CANDIDATE", "BLOCKED", "FAILED"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
    "report_path": {"$ref": "#/$defs/path"},
    "writes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}, "default": []},
    "validation": {"type": "array", "items": {"type": "string"}, "default": []},
    "requires_operator": {"type": "boolean", "default": false},
    "requires_codex": {"type": "boolean", "default": false},
    "first_three_runs_review": {"type": "boolean", "default": true},
    "worktree": {"anyOf": [{"$ref": "#/$defs/worktree"}, {"type": "null"}], "default": null},
    "safety": {"$ref": "#/$defs/safety"}
  },
  "$defs": {
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\u0000]+$"},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "source_path", "observation"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1, "maxLength": 80},
        "source_path": {"$ref": "#/$defs/path"},
        "source_sha256": {"anyOf": [{"type": "string", "pattern": "^[a-f0-9]{64}$"}, {"type": "null"}]},
        "observation": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "worktree": {
      "type": "object", "additionalProperties": false,
      "required": ["dedicated_worktree", "main_checkout_modified", "base_branch", "base_revision"],
      "properties": {
        "dedicated_worktree": {"const": true},
        "main_checkout_modified": {"const": false},
        "base_branch": {"const": "main"},
        "base_revision": {"type": "string", "pattern": "^[a-f0-9]{7,64}$"},
        "candidate_branch": {"anyOf": [{"type": "string", "not": {"enum": ["main", "refs/heads/main"]}}, {"type": "null"}]}
      }
    },
    "safety": {
      "type": "object", "additionalProperties": false,
      "required": [
        "real_orders_executed", "order_network_used", "production_secrets_accessed",
        "live_mode_changed", "risk_limits_changed", "model_promoted",
        "auto_merge_performed", "auto_deploy_performed"
      ],
      "properties": {
        "real_orders_executed": {"const": false},
        "order_network_used": {"const": false},
        "production_secrets_accessed": {"const": false},
        "live_mode_changed": {"const": false},
        "risk_limits_changed": {"const": false},
        "model_promoted": {"const": false},
        "auto_merge_performed": {"const": false},
        "auto_deploy_performed": {"const": false}
      }
    }
  }
}
