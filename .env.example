# QuantForge is paper-only by default. Do not put real credentials in this file.
QF_ENVIRONMENT=development
QF_TRADING_MODE=paper
QF_ALLOW_ORDER_SUBMISSION=false
QF_LIVE_RELEASE_MANIFEST_VALID=false
QF_RISK_POLICY_APPROVED=false
QF_MODEL_RELEASE_APPROVED=false
QF_OPERATOR_UNLOCK_PRESENT=false
QF_DATABASE_URL=postgresql+asyncpg://quantforge:quantforge@localhost:5432/quantforge
QF_LOG_LEVEL=INFO
QF_DISPLAY_TIMEZONE=Asia/Seoul

# Credentials are intentionally blank and must come from an external secret store.
QF_UPBIT_ACCESS_KEY=
QF_UPBIT_SECRET_KEY=
